{
  "name": "AI Workshop Demo",

  // Small base image with no dev tools: the features add them
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",

  // Features: add-ons, installed when the container is built.
  // "ghcr.io/..." is a ready-made feature from a registry. "./features/..." is our own, in this repo.
  "features": {
    // Trust the company root certificate, if there is one in features/corporate-ca/certs
    "./features/corporate-ca": {},

    // The tools. Each one downloads from its official site (nodejs.org, claude.ai, GitHub releases).
    "./features/node": { "version": "22" },
    "./features/claude-code": {},
    "./features/codex": {},
    "./features/github-cli": {},

    // A ready-made feature: SSH server (with SFTP), so that Claude Desktop can connect
    "ghcr.io/devcontainers/features/sshd:1": {},

    // Block all outgoing traffic except these sites, and limit sudo to the firewall script (see features/firewall)
    "./features/firewall": {
      "allowedSites": "api.anthropic.com claude.ai platform.claude.com downloads.claude.ai api.openai.com auth.openai.com chatgpt.com registry.npmjs.org github.com api.github.com update.code.visualstudio.com vscode.download.prss.microsoft.com marketplace.visualstudio.com gallery.vsassets.io gallerycdn.vsassets.io anthropic.gallerycdn.vsassets.io openai.gallerycdn.vsassets.io"
    }
  },

  // Install order: the certificates first, because the other features download over TLS
  "overrideFeatureInstallOrder": ["./features/corporate-ca"],

  // Wait for the firewall before VS Code says that the container is ready
  "waitFor": "postStartCommand",

  // Claude Desktop: a fixed name, so that the SSH config can find the container
  "runArgs": ["--name", "ai-workshop-demo"],

  // Claude Desktop: runs on YOUR computer before the build. Makes a key for this container only.
  "initializeCommand": "test -f \"$HOME/.ssh/ai-workshop-demo\" || (mkdir -p \"$HOME/.ssh\" && ssh-keygen -q -t ed25519 -N '' -C ai-workshop-demo -f \"$HOME/.ssh/ai-workshop-demo\")",

  // Login: keep the Claude, Codex and GitHub CLI config in named volumes, so that you log in one time only.
  // CLAUDE_CONFIG_DIR puts the file .claude.json in the volume too (the default place is the home folder).
  "containerEnv": {
    "CLAUDE_CONFIG_DIR": "/home/vscode/.claude"
  },
  "mounts": [
    "source=ai-workshop-claude,target=/home/vscode/.claude,type=volume",
    "source=ai-workshop-codex,target=/home/vscode/.codex,type=volume",
    "source=ai-workshop-gh,target=/home/vscode/.config/gh,type=volume",
    // Claude Desktop: only the PUBLIC key, read-only (never a private key)
    "source=${localEnv:HOME}/.ssh/ai-workshop-demo.pub,target=/tmp/host-key.pub,type=bind,readonly"
  ],

  // Claude Desktop: allow login with the key
  "postStartCommand": "mkdir -p ~/.ssh && cp /tmp/host-key.pub ~/.ssh/authorized_keys && chmod 700 ~/.ssh && chmod 600 ~/.ssh/authorized_keys",

  // Codex login: the browser comes back to port 1455 in the container
  "portsAttributes": {
    "1455": { "label": "Codex login", "onAutoForward": "silent" }
  },

  // VS Code customizations: they apply only in the window that is connected to the container
  "customizations": {
    "vscode": {
      "settings": {
        "workbench.colorCustomizations": {
          "titleBar.activeBackground": "#6b2fa3",
          "titleBar.activeForeground": "#ffffff",
          "titleBar.inactiveBackground": "#4a1f73",
          "titleBar.inactiveForeground": "#e0d0f0",
          "statusBar.background": "#6b2fa3",
          "statusBar.foreground": "#ffffff",
          "activityBar.background": "#4a1f73",
          "activityBar.foreground": "#ffffff"
        }
      },
      "extensions": ["anthropic.claude-code", "openai.chatgpt"]
    }
  }
}
