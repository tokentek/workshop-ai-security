#!/usr/bin/env bash
# agents: start the autonomous-agents Docker Sandbox for the current project.
#
# Run it from the project folder that the agents work on. It calls `sbx env`
# with this repo's sbxenv.yaml, the current folder as the workspace, and a
# stable sandbox name (agents-<folder>), so every command finds the same sandbox.
#
#   agents plan          preview what `sbx env` will create
#   agents claude        create (first time) and attach to Claude Code
#   agents codex         run Codex in the same sandbox
#   agents shell         open bash in the sandbox
#   agents exec CMD...   run a command in the sandbox
#   agents stop          stop the sandbox (keeps its state)
#   agents rm            remove the sandbox and its provisioned secrets
#
# Environment variables (optional):
#   AZDO_ORG, AZDO_PROJECT   Azure DevOps defaults for `az devops`
#   CLAUDE_MODEL, CODEX_MODEL
set -euo pipefail

# Follow symlinks (for example ~/.local/bin/agents) to find this repo folder.
self="${BASH_SOURCE[0]}"
while [ -L "$self" ]; do
  link="$(readlink "$self")"
  case "$link" in /*) self="$link" ;; *) self="$(dirname "$self")/$link" ;; esac
done
here="$(cd "$(dirname "$self")/.." && pwd -P)"
workspace="$(pwd -P)"
# The "-" is last in the set: GNU tr reads ".-\n" as a range and fails.
name="agents-$(basename "$workspace" | tr -c 'A-Za-z0-9_.\n-' '-')"

# Every `sbx env` command on one sandbox needs the same name, args and file.
envfile=(
  --name "$name"
  --env-arg "workspace=$workspace"
  --env-arg "azdoOrg=${AZDO_ORG:-}"
  --env-arg "azdoProject=${AZDO_PROJECT:-}"
  --env-arg "claudeModel=${CLAUDE_MODEL:-}"
  --env-arg "codexModel=${CODEX_MODEL:-}"
  "$here/sbxenv.yaml"
)

# This script and sbxenv.yaml run commands on the host. The agent can write
# to the workspace. So the workspace must not contain them: an agent that can
# edit them can run code on the host at the next start.
check_workspace() {
  case "$here/" in
    "${workspace%/}/"*)
      cat >&2 <<EOF
agents: this folder contains the sandbox configuration ($here).
The agent can write to its workspace, and the configuration runs commands on
your computer. Go to a project folder outside it, then run 'agents' again.
EOF
      exit 1 ;;
  esac
}

# The sandbox gets its Azure DevOps token from the host's `az login`.
check_az_login() {
  if ! az account get-access-token \
       --resource 499b84ac-1321-427f-aa17-267ca6975798 --output none >/dev/null 2>&1; then
    cat >&2 <<'EOF'
The Azure CLI on the host cannot get an Azure DevOps token. Sign in one time:

  az login

The sandbox proxy uses this sign-in for Azure DevOps. No PAT is necessary.
EOF
    exit 1
  fi
}

cmd="${1:-claude}"
shift || true

case "$cmd" in
  plan)    check_workspace
           exec sbx env plan "${envfile[@]}" ;;
  claude)  check_workspace; check_az_login
           exec sbx env run "${envfile[@]}" -- "$@" ;;
  codex)   check_workspace; check_az_login
           sbx env run --detach "${envfile[@]}"
           exec sbx env exec -it -w "$workspace" "${envfile[@]}" -- codex "$@" ;;
  shell)   exec sbx env exec -it -w "$workspace" "${envfile[@]}" -- bash -l ;;
  exec)    exec sbx env exec -w "$workspace" "${envfile[@]}" -- "$@" ;;
  stop)    exec sbx stop "$name" ;;
  rm)      exec sbx env rm "${envfile[@]}" ;;
  -h|--help|help) sed -n '2,18p' "$0" | sed 's/^# \{0,1\}//' ;;
  *) echo "agents: unknown command '$cmd' (try: agents help)" >&2; exit 2 ;;
esac
