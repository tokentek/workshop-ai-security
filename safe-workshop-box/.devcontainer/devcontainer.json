{
  "name": "Safe Workshop Box",

  // Same environment for everyone: built from the Dockerfile
  "build": {
    "dockerfile": "Dockerfile"
  },

  // Ready-made add-on: installs Python
  "features": {
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.12"
    }
  },

  // Keeps the Claude Code login across rebuilds
  "mounts": [
    "source=claude-config-${devcontainerId},target=/home/node/.claude,type=volume"
  ],

  // Firewall: allow the container to manage its own network rules
  "runArgs": [
    "--cap-add=NET_ADMIN",
    "--cap-add=NET_RAW"
  ],

  // Firewall: switch it on at every start, before anything else runs
  "postStartCommand": "sudo /usr/local/bin/firewall.sh",
  "waitFor": "postStartCommand"
}
